{
  "allowCustomDataForDataTypeAny": true,
  "allowErrorForDataTypeAny": true,
  "functions": [
    {
      "id": "PRICE",
      "name": "PRICE",
      "description": "Gets the latest OilPriceAPI price for a commodity code.",
      "helpUrl": "https://docs.oilpriceapi.com",
      "parameters": [
        {
          "name": "code",
          "description": "Commodity code, for example BRENT_CRUDE_USD.",
          "type": "string",
          "optional": false
        }
      ],
      "result": {
        "type": "number",
        "dimensionality": "scalar"
      }
    },
    {
      "id": "GET",
      "name": "GET",
      "description": "Calls a supported OilPriceAPI GET endpoint and returns a table.",
      "helpUrl": "https://docs.oilpriceapi.com",
      "parameters": [
        {
          "name": "path",
          "description": "Supported API path, for example /v1/prices/latest.",
          "type": "string",
          "optional": false
        },
        {
          "name": "query",
          "description": "Query string, for example by_code=BRENT_CRUDE_USD.",
          "type": "string",
          "optional": true
        }
      ],
      "result": {
        "type": "any",
        "dimensionality": "matrix"
      }
    },
    {
      "id": "CODES",
      "name": "CODES",
      "description": "Returns available OilPriceAPI commodity codes when supported by the API key.",
      "helpUrl": "https://docs.oilpriceapi.com",
      "parameters": [],
      "result": {
        "type": "any",
        "dimensionality": "matrix"
      }
    },
    {
      "id": "PRICE.STATUS",
      "name": "PRICE.STATUS",
      "description": "Reports the freshness of the latest quote (current, stale, ...) so stale data is distinguishable.",
      "helpUrl": "https://docs.oilpriceapi.com",
      "parameters": [
        {
          "name": "code",
          "description": "Commodity code, for example BALTIC_CAPESIZE_INDEX.",
          "type": "string",
          "optional": false
        }
      ],
      "result": {
        "type": "string",
        "dimensionality": "scalar"
      }
    },
    {
      "id": "PRICE.UNIT",
      "name": "PRICE.UNIT",
      "description": "Returns the currency and unit of a quote, for example GBp/therm, so values are not misread.",
      "helpUrl": "https://docs.oilpriceapi.com",
      "parameters": [
        {
          "name": "code",
          "description": "Commodity code, for example NATURAL_GAS_GBP.",
          "type": "string",
          "optional": false
        }
      ],
      "result": {
        "type": "string",
        "dimensionality": "scalar"
      }
    },
    {
      "id": "PRICE.INFO",
      "name": "PRICE.INFO",
      "description": "Spills a table with the latest price, currency, unit, formatted value, and freshness.",
      "helpUrl": "https://docs.oilpriceapi.com",
      "parameters": [
        {
          "name": "code",
          "description": "Commodity code, for example NATURAL_GAS_GBP.",
          "type": "string",
          "optional": false
        }
      ],
      "result": {
        "type": "any",
        "dimensionality": "matrix"
      }
    }
  ]
}
