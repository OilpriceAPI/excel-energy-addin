{
  "name": "excel-energy-addin",
  "version": "1.1.1",
  "description": "Excel add-in for refreshable OilPriceAPI formulas",
  "main": "dist/index.js",
  "scripts": {
    "audit:ci": "npm audit --omit=dev --audit-level=moderate && npm audit --audit-level=critical",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "scan:secrets": "node scripts/scan-secrets.js",
    "generate:icons": "node generate-icons.js",
    "validate:claims": "node scripts/validate-source-claims.js",
    "build": "webpack --mode production",
    "postbuild": "node scripts/stamp-cache-bust.js",
    "dev": "webpack serve --config webpack.dev.js",
    "start": "npm run dev"
  },
  "keywords": [
    "excel",
    "energy",
    "commodities",
    "prices",
    "oil",
    "gas",
    "coal"
  ],
  "author": "OilPriceAPI",
  "license": "MIT",
  "type": "commonjs",
  "overrides": {
    "@hono/node-server": "^2.0.11",
    "@xmldom/xmldom": "0.8.15",
    "adm-zip": "^0.6.1",
    "brace-expansion": "^5.0.8",
    "browserslist": "4.28.8",
    "fast-uri": "3.1.8",
    "hono": "^4.13.7",
    "js-yaml": "^4.3.2",
    "qs": "6.16.0",
    "tar": "^7.5.22",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/office-js": "^1.0.609",
    "copy-webpack-plugin": "^14.0.0",
    "jest": "^30.5.0",
    "office-addin-debugging": "^7.0.0",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.0",
    "sharp": "^0.35.4",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.111.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "yaml": "^2.9.1"
  }
}
