{
  "name": "excel-energy-addin",
  "version": "1.1.1",
  "description": "Excel add-in for refreshable OilPriceAPI formulas",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "scan:secrets": "node scripts/scan-secrets.js",
    "generate:icons": "node generate-icons.js",
    "validate:claims": "node scripts/validate-source-claims.js",
    "build": "webpack --mode production",
    "postbuild": "node scripts/stamp-cache-bust.js",
    "dev": "webpack serve --config webpack.dev.js",
    "start": "npm run dev"
  },
  "keywords": [
    "excel",
    "energy",
    "commodities",
    "prices",
    "oil",
    "gas",
    "coal"
  ],
  "author": "OilPriceAPI",
  "license": "MIT",
  "type": "commonjs",
  "overrides": {
    "@hono/node-server": "^2.0.11",
    "adm-zip": "^0.6.0",
    "brace-expansion": "^5.0.8",
    "tar": "^7.5.22",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/office-js": "^1.0.604",
    "copy-webpack-plugin": "^14.0.0",
    "jest": "^30.4.2",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.3",
    "office-addin-manifest": "^2.0.3",
    "sharp": "^0.35.3",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "yaml": "^2.9.0"
  }
}
